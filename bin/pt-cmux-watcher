#!/usr/bin/env bash
# pt-cmux-watcher — detached helper spawned by pt-cmux-status at session
# start. Polls the given PIDs until every one has exited, then clears the
# cmux workspace status pin back to `auto` (Polytoken hooks have no
# session-exit event, so this is how the lane is unpinned on exit).
#
# Usage: pt-cmux-watcher <pid> [<pid> ...]
#
# The watcher is intentionally dumb: it owns no state, makes exactly one
# cmux call at the end of its life, and can be killed at any time without
# leaving anything behind (worst case: a stale pin, which the next
# session's reset clears).
#
# Contract: ALWAYS exits 0 and NEVER writes to stdout.
#
# Environment:
#   PTCMUX_CMUX_BIN           explicit cmux binary (authoritative override)
#   PTCMUX_LOG                log file path
#   PTCMUX_WATCHER_FLAG       flag file to delete as the final act
#                             (set by pt-cmux-status when it spawns us)
#   PTCMUX_WATCH_INTERVAL     poll interval in seconds (default 2)

PIDS="$*"
[ -n "$PIDS" ] || exit 0

INTERVAL="${PTCMUX_WATCH_INTERVAL:-2}"
case "$INTERVAL" in
  ''|*[!0-9]*) INTERVAL=2 ;;
esac

LOG_FILE="${PTCMUX_LOG:-${TMPDIR:-/tmp}/pt-cmux-status/error.log}"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
# 2>/dev/null first: a failed redirection (unwritable path, directory)
# must not leak to our stderr.
if ! : 2>/dev/null >>"$LOG_FILE"; then
  LOG_FILE=/dev/null
fi

log_error() {
  printf '%s pt-cmux-watcher: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" 2>/dev/null >>"$LOG_FILE"
}

resolve_cmux() {
  # Print the path of the cmux binary, or return 1 if none is usable.
  if [ -n "${PTCMUX_CMUX_BIN:-}" ]; then
    if [ -x "$PTCMUX_CMUX_BIN" ]; then
      printf '%s\n' "$PTCMUX_CMUX_BIN"
      return 0
    fi
    return 1
  fi
  found="$(command -v cmux 2>/dev/null)"
  if [ -n "$found" ]; then
    printf '%s\n' "$found"
    return 0
  fi
  if [ -x /Applications/cmux.app/Contents/Resources/bin/cmux ]; then
    printf '%s\n' /Applications/cmux.app/Contents/Resources/bin/cmux
    return 0
  fi
  return 1
}

while :; do
  alive=0
  for p in $PIDS; do
    if kill -0 "$p" 2>/dev/null; then
      alive=1
      break
    fi
  done
  [ "$alive" = "1" ] || break
  sleep "$INTERVAL" 2>/dev/null || exit 0
done

if CMUX="$(resolve_cmux)"; then
  if ! "$CMUX" workspace status set auto >/dev/null 2>>"$LOG_FILE"; then
    log_error "cmux workspace status set auto failed"
  fi
else
  log_error "cmux binary not found"
fi

# Final act: remove the flag file — but only if it still names us. The
# parent writes the flag after spawning; if we got here before that write
# landed (fast all-dead-at-startup exit), the file does not name us and a
# later writer owns it.
if [ -n "${PTCMUX_WATCHER_FLAG:-}" ]; then
  recorded="$(cat "$PTCMUX_WATCHER_FLAG" 2>/dev/null)"
  if [ "$recorded" = "$$" ]; then
    rm -f "$PTCMUX_WATCHER_FLAG" 2>/dev/null
  fi
fi

exit 0
